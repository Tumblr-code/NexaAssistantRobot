# 从 @BotFather 获取。不要提交真实 Token。
BOT_TOKEN=123456789:replace_me
# 生产环境必须锁定与 Token 对应的机器人身份，防止误用 Token。
EXPECTED_BOT_ID=123456789
EXPECTED_BOT_USERNAME=ExampleGuardBot

# 默认安全策略：为空时不自动管理任何群，仅允许查看 /status。
# 填入目标群数字 ID 后再启动自动群管；多个 ID 用英文逗号分隔。
ALLOWED_CHAT_IDS=-1001234567890

# 群内可配置一个或多个数字用户 ID；私聊管理必须恰好配置一个，其他私聊会被静默忽略。
# 开启“匿名管理员”时 Telegram 不提供真实用户 ID，需暂时关闭匿名身份后执行命令。
AUTHORIZED_ADMIN_IDS=

# 可选：集中接收管理日志的私有群/频道 ID；机器人必须能在其中发消息。
LOG_CHAT_ID=
DATABASE_PATH=data/guardian.db

# AI 模式下，这些旧规则只用于“可疑消息”预检，不直接删除；AI 关闭时继续兼容旧过滤。
BLOCK_EXTERNAL_LINKS=true
ALLOWED_DOMAINS=

# 旧人工词库仅用于 AI 关闭时的兼容回滚；AI 模式不会用它直接拦截。
BLOCKED_WORDS=
# true 时拦截普通成员转发的内容；管理员和 Telegram 自动转发不受影响。
BLOCK_FORWARDS=false
# true 时仅拦截带推广语境或一次推广多个账号的 @提及，正常单个 @成员不会删除。
BLOCK_CHANNEL_MENTIONS=false

# 自动处置：每次违规 +1 警告，达到阈值后封禁并清零。
WARN_LIMIT=3
# 机器人在群聊及日志群发送的消息保留 30 秒；授权管理员私聊回复永久保留。
NOTICE_TTL_SECONDS=30
# aiogram 同时处理的 update 上限，避免突发图片占用无界内存。
UPDATE_CONCURRENCY_LIMIT=32

# 刷屏：8 秒内第 7 条消息触发；相同内容 30 秒内第 3 次触发。
FLOOD_WINDOW_SECONDS=8
FLOOD_MAX_MESSAGES=6
DUPLICATE_WINDOW_SECONDS=30
DUPLICATE_MAX_MESSAGES=2

# true 仅禁用自动删除/警告/封禁，手工管理员命令仍会执行。
# Automatic moderation only; manual administrator commands still execute.
DRY_RUN=false

# ── AI 审核：任何兼容 OpenAI 接口的模型都可以 ─────────────────────────────
# 不要把真实密钥提交到 Git。
AI_ENABLED=false
# 接口地址。必须是 https://（本机服务如 Ollama 可用 http://localhost）。
# 以 /v1 结尾或只写域名都可以，程序会补全路径。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
# 模型 ID，按你的服务商填写。
AI_MODEL=deepseek-flash
# 接口风格：responses（OpenAI Responses API）或 chat_completions（多数兼容服务支持）。
AI_API_STYLE=responses
# 结构化输出：json_schema（严格模式，推荐）或 json_object（模型不支持 JSON Schema 时使用）。
AI_STRUCTURED_OUTPUT=json_schema
# 思考强度：none、minimal、low、medium、high；留空则不发送该参数。
AI_REASONING_EFFORT=none
AI_NORMAL_REASONING_EFFORT=none
AI_SUSPICIOUS_REASONING_EFFORT=none
# 服务等级参数；留空则不发送。
AI_SERVICE_TIER=default
# true 时要求服务端在响应里原样回显模型、服务等级和思考强度，不一致即判为失败。
# 多数兼容网关不回显，保持 false 即可。
AI_STRICT_RESPONSE=false
# 保留旧配置以便回滚；单次审核模式不使用此二次复核阈值。
AI_NORMAL_ACCEPT_CONFIDENCE=0.90
AI_SERVICE_TIER=default
AI_AD_THRESHOLD=0.92
AI_LEARN_THRESHOLD=0.97
AI_TIMEOUT_SECONDS=12
AI_CONCURRENCY=8
AI_CACHE_TTL_SECONDS=600
AI_CACHE_MAX_ENTRIES=1000
# AI 调用失败时删除原消息，但不警告、不封禁、不学习。
AI_FAILURE_DELETE=true
AI_DECISION_RETENTION_DAYS=30
AI_IMAGE_MAX_BYTES=1572864
AI_IMAGE_TARGET_LONG_EDGE=1280
AI_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=2
AI_MEDIA_CONCURRENCY=4

# 可选：/del all 和 /del members 共用的管理员 MTProto 用户会话。ID 与 Hash 必须同时配置；首次登录只在服务器上交互完成。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/var/lib/nexa-guardian/mtproto/admin

LOG_LEVEL=INFO

# ── 身份与品牌：全部可选 ────────────────────────────────────────────────
# 机器人自称的名字，用于审核提示词、/help 和机器人资料。默认 Guardian。
BRAND_NAME=
# 社区名称，例如你的品牌或群名。留空则称“本群”。
COMMUNITY_NAME=
# 你自己的官方站点，格式：名称|https://域名，多个用英文逗号分隔。
# 这些域名本身不会被当作外链广告；仿冒的相似域名仍会进入审核。
OFFICIAL_SITES=
# 展示给成员看的模型名称，例如 GPT、DeepSeek。留空显示 AI。
AI_MODEL_LABEL=
# 机器人显示名。留空为“<BRAND_NAME> 群管助手”。
BOT_PROFILE_NAME=
# true 时启动后把机器人的名称、简介和介绍同步为上面生成的内容；
# 想自己在 BotFather 里维护资料就设为 false（命令菜单仍会同步）。
SYNC_BOT_PROFILE=true
