# 从 @BotFather 获取。不要提交真实 Token。
BOT_TOKEN=123456789:replace_me

# 默认安全策略：为空时不自动管理任何群，只响应群管理员的 /chatid 和 /status。
# 先把机器人加到群里，用 /chatid 获取群 ID，再填入并重启。多个 ID 用英文逗号分隔。
ALLOWED_CHAT_IDS=-1001234567890

# 可选：只允许这些数字用户 ID 执行手动管理命令；为空表示按 Telegram 实际管理员权限判断。
# 开启“匿名管理员”时 Telegram 不提供真实用户 ID，需暂时关闭匿名身份后执行命令。
AUTHORIZED_ADMIN_IDS=

# 可选：集中接收管理日志的私有群/频道 ID；机器人必须能在其中发消息。
LOG_CHAT_ID=
DATABASE_PATH=data/guardian.db

# AI 模式下，这些旧规则只用于“可疑消息”预检，不直接删除；AI 关闭时继续兼容旧过滤。
BLOCK_EXTERNAL_LINKS=true
ALLOWED_DOMAINS=

# 旧人工词库仅用于 AI 关闭时的兼容回滚；AI 模式不会用它直接拦截。
BLOCKED_WORDS=
# true 时拦截普通成员转发的内容；管理员和 Telegram 自动转发不受影响。
BLOCK_FORWARDS=false
# true 时仅拦截带推广语境或一次推广多个账号的 @提及，正常单个 @成员不会删除。
BLOCK_CHANNEL_MENTIONS=false

# 自动处置：每次违规 +1 警告，达到阈值后封禁并清零。
WARN_LIMIT=3
# 手动 /mute 未指定时长时使用这个默认值。
DEFAULT_MUTE_SECONDS=3600
# 机器人在群聊和私聊发送的所有消息统一保留 30 秒。
NOTICE_TTL_SECONDS=30

# 刷屏：8 秒内第 7 条消息触发；相同内容 30 秒内第 3 次触发。
FLOOD_WINDOW_SECONDS=8
FLOOD_MAX_MESSAGES=6
DUPLICATE_WINDOW_SECONDS=30
DUPLICATE_MAX_MESSAGES=2

# true 时只记录命中，不删除、不警告、不禁言；建议首次进群观察规则时临时开启。
DRY_RUN=false

# GPT-5.6 Sol 广告审核。启用时 Base URL 和 Key 必填；兼容网关需支持 /v1/responses、
# Structured Outputs、图片输入、高推理强度和可核验的服务层。不要把真实密钥提交到 Git。
AI_ENABLED=false
OPENAI_BASE_URL=https://gateway.example/v1
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-sol
AI_REASONING_EFFORT=high
AI_SERVICE_TIER=default
AI_AD_THRESHOLD=0.92
AI_LEARN_THRESHOLD=0.97
AI_TIMEOUT_SECONDS=8
AI_CONCURRENCY=8
AI_CACHE_TTL_SECONDS=600
AI_CACHE_MAX_ENTRIES=1000
# AI 调用失败时删除原消息，但不警告、不封禁、不学习。
AI_FAILURE_DELETE=true
AI_DECISION_RETENTION_DAYS=30
AI_IMAGE_MAX_BYTES=5242880

LOG_LEVEL=INFO
